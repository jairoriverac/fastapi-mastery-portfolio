# ==============================================================================
# VARIABLES DE ENTORNO - CONFIGURACIÓN BASE
# Copia este archivo a `.env` en la raíz de tu proyecto: `cp .env.example .env`
# ==============================================================================

# Entorno de ejecución: development | staging | production
ENVIRONMENT=development
APP_NAME="FastAPI Mastery Portfolio"
DEBUG=True

# OpenRouter API (Módulos 06 y 09)
# Consigue tu key gratuita o con créditos en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-001

# Seguridad y Autenticación JWT (Módulos 05 y 09)
# Generar una clave segura con: openssl rand -hex 32
JWT_SECRET_KEY=clave_secreta_super_segura_de_al_menos_32_caracteres_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de datos PostgreSQL Asíncrona (Módulos 04 y 09)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_db

# Caché Redis (Módulos 05, 08 y 09)
REDIS_URL=redis://localhost:6379/0